    <style>
         .mint-toast.override-styles-toast::after {
            content: '';
        }

        .mint-toast.override-styles-toast.warning-toast {
            background-color: var(--color-destructive-600);
        }

        .mint-toast-container:has(.override-styles-toast) {
          display: grid;
          grid-template-areas: "top" "bottom";
          grid-template-rows: 50% 50%;
          grid-template-columns: 100%;
          /* stylelint-disable-line */
          height: 100vh;
          width: 100%;
          position: fixed;
          top: 0;
          left: 0;
          padding: 20px;
          pointer-events: none;
          z-index: 10000;
        }

        @media (min-width: 768px) {
          .mint-toast-container:has(.override-styles-toast) {
            grid-template-areas: "top-left top-center top-right" "bottom-center bottom-center bottom-center";
            grid-template-columns: repeat(3, 33%);
            /* stylelint-disable-line */
            grid-template-rows: repeat(2, 50%);
          }
        }
        .mint-toast-section:has(.override-styles-toast) {
          grid-area: bottom;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: flex-end;
        }

        @media (min-width: 768px) {
          .mint-toast-section:has(.override-styles-toast) {
            grid-area: bottom-center;
          }
        }
        .mint-toast.override-styles-toast {
          color: var(--color-white, #ffffff);
          background-color: var(--color-success-700, #016b64);
          width: 100%;
          max-width: 500px;
          margin: var(--base-spacing) auto 0 auto;
          height: calc(7 * var(--base-spacing));
          padding: calc(2 * var(--base-spacing)) calc(8 * var(--base-spacing));
          padding-left: calc(2 * var(--base-spacing));
          font-weight: 400;
          font-size: 1rem;
          line-height: 1.5;
          overflow: hidden;
          justify-content: flex-start;
          align-items: flex-start;
          text-align: left;
          text-overflow: ellipsis;
          white-space: nowrap;
          position: relative;
          pointer-events: all;
          border-radius: var(--base-border-radius);
          transition: opacity 0.25s ease-out, transform 0.25s ease-out;
          opacity: 0;
          transform: translateY(100%);
        }

        .mint-toast.override-styles-toast.in {
          opacity: 1;
          transform: translate(0);
        }

        .mint-toast.override-styles-toast.out {
          display:none;
        }

        .mint-toast.override-styles-toast .close-btn {
          background: none;
          border: none;
          padding: 0;
          margin: 0;
          color: currentColor;
          text-align: inherit;
          /* stylelint-disable-next-line */
          -webkit-transition: background-color var(--transition-duration);
          transition: background-color var(--transition-duration);
          position: absolute;
          right: 0;
          top: 0;
          font-family: sans-serif;
          font-weight: bold;
          font-size: 1.375rem;
          line-height: 1;
          height: 100%;
          text-align: center;
          width: 48px;
          z-index: 999999;
        }

        @media (prefers-reduced-motion) {
          .mint-toast.override-styles-toast .close-btn {
            transition: none !important;
          }
        }
        .mint-toast.override-styles-toast .close-btn:hover, .mint-toast.override-styles-toast .close-btn:focus {
          background-color: rgba(0, 0, 0, 0.3);
        }
    </style>

